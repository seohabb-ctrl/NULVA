/* =========================================================
   READY LINE
   타이핑 중  : 흰색
   타이핑 완료 후 0.5초 대기
   그 다음   : 한 번에 초록색
========================================================= */


/* ---------------------------------------------------------
   타이핑 중
--------------------------------------------------------- */

#boot-lines > div:nth-child(8) {

    color:
        #e1edf5;

    text-shadow:
        none;

}


/* ---------------------------------------------------------
   타이핑 완료
   JS에서 .typing 클래스가 제거되는 순간
   이 규칙이 활성화된다.
--------------------------------------------------------- */

#boot-lines > div:nth-child(8):not(.typing) {

    animation:
        nulva-ready-green
        .01s
        steps(1)
        .5s
        forwards;

}


/* ---------------------------------------------------------
   0.5초 대기
   → 흰색 유지
   → 순간적으로 초록색
--------------------------------------------------------- */

@keyframes nulva-ready-green {

    0% {

        color:
            #e1edf5;

        text-shadow:
            none;

    }


    100% {

        color:
            #45e889;

        text-shadow:

            0 0 10px
            rgba(
                69,
                232,
                137,
                .35
            ),

            0 0 24px
            rgba(
                69,
                232,
                137,
                .12
            );

    }

}


/* =========================================================
   MEMORY ERROR
========================================================= */

#boot-lines > div:nth-child(6) {

    color:
        #ff4d5a !important;

    text-shadow:

        0 0 8px
        rgba(
            255,
            77,
            90,
            .22
        );

}


/* =========================================================
   BOOT LOGO
   기본적으로 숨김
========================================================= */

#boot-logo {

    opacity:
        0;

    visibility:
        hidden;

    transform:
        translate(
            -50%,
            -50%
        )
        scale(
            .985
        );

    filter:
        blur(2px);

}


/* =========================================================
   LOGO 등장
   JS에서 .hidden이 제거되면 실행
========================================================= */

#boot-logo:not(.hidden) {

    visibility:
        visible;

    animation:
        nulva-logo-glitch
        1.15s
        steps(1)
        both;

}


/* =========================================================
   GLITCH LOGO
========================================================= */

@keyframes nulva-logo-glitch {

    /* 완전 암전 */

    0% {

        opacity:
            0;

        transform:
            translate(
                -50%,
                -50%
            )
            scale(
                .97
            );

        filter:
            blur(8px);

        clip-path:
            inset(
                48% 0 48% 0
            );

    }


    /* 첫 신호 */

    8% {

        opacity:
            .25;

        transform:
            translate(
                calc(-50% - 7px),
                -50%
            )
            scale(
                1.01
            );

        filter:
            blur(2px);

        clip-path:
            inset(
                20% 0 58% 0
            );

    }


    /* 튀는 순간 */

    13% {

        opacity:
            .9;

        transform:
            translate(
                calc(-50% + 5px),
                -50%
            )
            scale(
                .995
            );

        filter:
            blur(0);

        clip-path:
            inset(
                62% 0 18% 0
            );

    }


    18% {

        opacity:
            .35;

        transform:
            translate(
                calc(-50% - 3px),
                -50%
            );

        clip-path:
            inset(
                10% 0 72% 0
            );

    }


    24% {

        opacity:
            1;

        transform:
            translate(
                -50%,
                -50%
            );

        filter:
            blur(0);

        clip-path:
            inset(
                0 0 0 0
            );

    }


    /* 짧은 지지직 */

    31% {

        opacity:
            .55;

        transform:
            translate(
                calc(-50% + 2px),
                -50%
            );

        clip-path:
            inset(
                35% 0 38% 0
            );

    }


    38% {

        opacity:
            1;

        transform:
            translate(
                -50%,
                -50%
            );

        clip-path:
            inset(
                0 0 0 0
            );

    }


    /* 안정화 */

    55% {

        opacity:
            1;

        transform:
            translate(
                -50%,
                -50%
            )
            scale(
                1
            );

        filter:
            blur(0);

        clip-path:
            inset(
                0 0 0 0
            );

    }


    100% {

        opacity:
            1;

        transform:
            translate(
                -50%,
                -50%
            )
            scale(
                1
            );

        filter:
            blur(0);

        clip-path:
            inset(
                0 0 0 0
            );

    }

}


/* =========================================================
   LOGO 자체에도 아주 약한 CRT 흔들림
========================================================= */

#boot-logo:not(.hidden) h1 {

    animation:
        nulva-logo-text-glitch
        1.15s
        steps(1)
        both;

}


@keyframes nulva-logo-text-glitch {

    0%,
    18% {

        text-shadow:
            none;

    }


    19% {

        text-shadow:

            -3px 0
            rgba(
                255,
                70,
                90,
                .35
            ),

            3px 0
            rgba(
                70,
                180,
                255,
                .35
            );

    }


    23% {

        text-shadow:

            2px 0
            rgba(
                255,
                70,
                90,
                .28
            ),

            -2px 0
            rgba(
                70,
                180,
                255,
                .28
            );

    }


    27%,
    100% {

        text-shadow:

            0 0 12px
            rgba(
                76,
                159,
                255,
                .20
            ),

            0 0 30px
            rgba(
                76,
                159,
                255,
                .08
            );

    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (
    prefers-reduced-motion: reduce
) {

    #boot-logo:not(.hidden) {

        animation:
            none;

        opacity:
            1;

        visibility:
            visible;

    }

