   TOAST REDUCED MOTION
========================================================= */

@media (
    prefers-reduced-motion: reduce
) {

    .toast {

        transition:
            none;

    }

}

/* =========================================================
   NULVA MEMORY WINDOW
   SUBJECT-001
========================================================= */


/* =========================================================
   MEMORY OVERLAY
========================================================= */

.nulva-memory-overlay {

    position: fixed;

    inset: 0;

    z-index: 9999;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 32px;

    background:
        rgba(0, 5, 10, 0.82);

    backdrop-filter:
        blur(4px);

    -webkit-backdrop-filter:
        blur(4px);

}


/* =========================================================
   MEMORY WINDOW
========================================================= */

.nulva-memory-window {

    position: relative;

    width: min(
        1100px,
        92vw
    );

    height: min(
        720px,
        82vh
    );

    min-height: 420px;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    background:
        linear-gradient(
            180deg,
            rgba(5, 15, 23, 0.98),
            rgba(2, 9, 15, 0.98)
        );

    border:
        1px solid
        rgba(43, 157, 230, 0.65);

    box-shadow:

        0 0 0 1px
        rgba(19, 94, 137, 0.18),

        0 0 40px
        rgba(0, 120, 200, 0.12),

        inset 0 0 40px
        rgba(0, 100, 160, 0.04);

}


/* =========================================================
   CORNER HUD
========================================================= */

.nulva-memory-window::before,
.nulva-memory-window::after {

    content: "";

    position: absolute;

    pointer-events: none;

    z-index: 5;

}


/* top-left / bottom-right */

.nulva-memory-window::before {

    inset:
        0
        auto
        auto
        0;

    width:
        42px;

    height:
        42px;

    border-top:
        2px solid
        #2196dc;

    border-left:
        2px solid
        #2196dc;

}


/* top-right */

.nulva-memory-window::after {

    top:
        0;

    right:
        0;

    width:
        42px;

    height:
        42px;

    border-top:
        2px solid
        #2196dc;

    border-right:
        2px solid
        #2196dc;

}


/* =========================================================
   MEMORY HEADER
========================================================= */

.nulva-memory-header {

    position: relative;

    flex:
        0 0 82px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
        0 28px;

    border-bottom:
        1px solid
        rgba(43, 157, 230, 0.28);

    background:
        rgba(2, 10, 17, 0.72);

}


/* =========================================================
   MEMORY TITLE
========================================================= */

.nulva-memory-title {

    display: flex;

    align-items: center;

    gap:
        14px;

    color:
        #d8edf8;

    font-family:
        inherit;

    font-size:
        24px;

    font-weight:
        600;

    letter-spacing:
        0.18em;

    text-transform:
        uppercase;

}


/* left blue line */

.nulva-memory-title::before {

    content: "";

    display: block;

    width:
        3px;

    height:
        30px;

    background:
        #2196dc;

    box-shadow:
        0 0 8px
        rgba(33, 150, 220, 0.5);

}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.nulva-memory-close {

    width:
        42px;

    height:
        42px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    padding:
        0;

    border:
        0;

    background:
        transparent;

    color:
        #2196dc;

    font-family:
        inherit;

    font-size:
        30px;

    font-weight:
        300;

    line-height:
        1;

    cursor:
        pointer;

    transition:
        color 0.15s ease,
        text-shadow 0.15s ease,
        transform 0.15s ease;

}


.nulva-memory-close:hover {

    color:
        #ffffff;

    text-shadow:
        0 0 12px
        rgba(33, 150, 220, 0.8);

    transform:
        scale(1.08);

}


/* =========================================================
   MEMORY CONTENT
========================================================= */

.nulva-memory-content {

    flex:
        1 1 auto;

    min-height:
        0;

    overflow-y:
        auto;

    overflow-x:
        hidden;

    padding:
        0 22px 18px 28px;

    scrollbar-width:
        thin;

    scrollbar-color:
        #218ed1
        rgba(10, 35, 52, 0.8);

}


/* =========================================================
