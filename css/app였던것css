/* =========================================================
   NULVA
   app.css
   PART 1 / 5
   전체 삭제 후 여기부터 순서대로 붙여넣기
========================================================= */


/* =========================================================
   FONT
========================================================= */

@import url(
    'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+KR:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&family=VT323&display=swap'
);


@font-face {

    font-family:
        "NULVA Korean Pixel";

    src:
        url("../fonts/neodgm.woff2")
        format("woff2");

    font-weight:
        400;

    font-style:
        normal;

    font-display:
        swap;

}


/* =========================================================
   VARIABLES
========================================================= */

:root {

    --bg:
        #030609;

    --panel:
        #080d13;

    --panel-dark:
        #05090e;

    --line:
        #172a3a;

    --line-bright:
        #23435b;

    --text:
        #d8e7f2;

    --muted:
        #718899;

    --blue:
        #4c9fff;

    --blue-bright:
        #72c9ff;

    --blue-dark:
        #173a5a;

    --warning:
        #c49a55;

    --danger:
        #a85e6b;

    --ok:
        #6fa88e;


    --font-digital:
        "VT323",
        monospace;

    --font-korean-pixel:
        "NULVA Korean Pixel",
        sans-serif;

    --font-logo:
        "Space Grotesk",
        sans-serif;

    --font-readable:
        "NULVA Korean Pixel",
        sans-serif;


    /* S25+ 가로 기준 게임 좌표 */

    --game-width:
        2340px;

    --game-height:
        1080px;

    --game-scale:
        1;

}


/* =========================================================
   RESET
========================================================= */

html,
body {

    width:
        100%;

    height:
        100%;

    margin:
        0;

    padding:
        0;

    overflow:
        hidden;

    background:
        var(--bg);

    color:
        var(--text);

    font-family:
        var(--font-readable);

    font-size:
        16px;

}


*,
*::before,
*::after {

    box-sizing:
        border-box;

}


button,
input,
textarea {

    font:
        inherit;

}


button {

    cursor:
        pointer;

    user-select:
        none;

    -webkit-user-select:
        none;

    -webkit-tap-highlight-color:
        transparent;

}


button,
input {

    -webkit-appearance:
        none;

    appearance:
        none;

}


button:focus,
input:focus,
textarea:focus {

    outline:
        none;

}


.hidden {

    display:
        none !important;

}


/* =========================================================
   GAME ROOT
========================================================= */

#game {

    position:
        fixed;

    inset:
        0;

    width:
        100vw;

    height:
        100dvh;

    overflow:
        hidden;

    background:
        #030609;

    user-select:
        none;

    -webkit-user-select:
        none;

}


/* =========================================================
   FIXED S25+ LANDSCAPE CANVAS
========================================================= */

.screen {

    position:
        absolute;

    top:
        50%;

    left:
        50%;

    width:
        2340px;

    height:
        1080px;

    transform:
        translate(
            -50%,
            -50%
        )
        scale(
            var(--game-scale)
        );

    transform-origin:
        center center;

    overflow:
        hidden;

    will-change:
        transform;

}


/* =========================================================
   PORTRAIT WARNING
========================================================= */

@media (
    orientation: portrait
) {

    #game::before {

        content:
            "PLEASE ROTATE YOUR DEVICE";

        position:
            fixed;

        inset:
            0;

        z-index:
            9999;

        display:
            grid;

        place-items:
            center;

        background:
            #030609;

        color:
            var(--text);

        font-family:
            var(--font-logo);

        font-size:
            24px;

        font-weight:
            500;

        letter-spacing:
            .14em;

        text-align:
            center;

    }


    #game::after {

        content:
            "NULVA / LANDSCAPE MODE";

        position:
            fixed;

        top:
            calc(
                50% + 42px
            );

        left:
            50%;

        z-index:
            10000;

        transform:
            translateX(-50%);

        color:
            var(--muted);

        font-family:
            var(--font-digital);

        font-size:
            20px;

        letter-spacing:
            .12em;

        white-space:
            nowrap;

    }


    .screen {

        pointer-events:
            none;

    }

}


/* =========================================================
   BOOT / RESEARCHER BACKGROUND
========================================================= */

.boot-screen,
.researcher-screen {

    display:
        grid;

    place-items:
        center;

    background:

        radial-gradient(
            circle at 50% 45%,
            #0b1b2b 0%,
            #050b12 35%,
            #030609 70%,
            #010204 100%
        );

}

/* =========================================================
   BOOT CONTENT
========================================================= */

.boot-content {

    position:
        relative;

    width:
        100%;

    height:
        100%;

    max-width:
        none;

    text-align:
        center;

}


/* =========================================================
   BOOT TERMINAL
   좌측 상단
========================================================= */

.boot-kicker {

    position:
        absolute;

    top:
        38px;

    left:
        78px;

    z-index:
        20;

    width:
        max-content;

    transform:
        none;

    color:
        #60798b;

    font-family:
        var(--font-digital);

    font-size:
        30px;

    letter-spacing:
        .14em;

}


.boot-lines {

    position:
        absolute;

    top:
        86px;

    left:
        78px;

    z-index:
        20;

    width:
        1000px;

    min-height:
        0;

    margin:
        0;

    padding:
        0;

    text-align:
        left;

    font-family:
        var(--font-digital);

    font-size:
        36px;

    line-height:
        1.55;

    letter-spacing:
        .04em;

    white-space:
        pre-wrap;

}


.boot-lines > div {

    min-height:
        1.25em;

}


.boot-lines .korean-system {

    font-family:
        var(--font-korean-pixel);

    font-size:
        31px;

    line-height:
        1.7;

    letter-spacing:
        0;

    color:
        #d0dfe7;

}


/* =========================================================
   BOOT CURSOR
========================================================= */

.boot-lines > div.typing::after {

    content:
        "█";

    display:
        inline-block;

    margin-left:
        4px;

    color:
        #d0dfe7;

    animation:
        nulva-terminal-cursor
        .5s
        steps(1)
        infinite;

}


@keyframes nulva-terminal-cursor {

    0%,
    49% {

        opacity:
            1;

    }

    50%,
    100% {

        opacity:
            0;

    }

}


/* =========================================================
   BOOT LOGO
========================================================= */

.boot-logo {

    position:
        absolute;

    top:
        50%;

    left:
        50%;

    width:
        max-content;

    max-width:
        90%;

    transform:
        translate(
            -50%,
            -50%
        );

    text-align:
        center;

}


.boot-logo h1 {

    margin:
        0;

    color:
        #e1edf5;

    font-family:
        var(--font-logo);

    font-size:
        150px;

    font-weight:
        500;

    letter-spacing:
        .22em;

    line-height:
        .95;

    transform:
        translateX(
            .11em
        );

    text-shadow:

        0 0 10px
        rgba(
            76,
            159,
            255,
            .14
        ),

        0 0 30px
        rgba(
            76,
            159,
            255,
            .05
        );

}


.boot-logo p {

    margin:
        22px 0 0;

    color:
        #7890a0;

    font-family:
        var(--font-readable);

    font-size:
        22px;

    line-height:
        1.7;

    letter-spacing:
        .12em;

}


/* =========================================================
   PRIMARY BUTTON
========================================================= */

.primary-button {

    margin-top:
        38px;

    min-height:
        68px;

    padding:
        17px 44px;

    border:
        1px solid
        #28547a;

    background:
        #081522;

    color:
        var(--text);

    font-family:
        var(--font-digital);

    font-size:
        29px;

    letter-spacing:
        .12em;

    box-shadow:

        inset 0 0 20px
        rgba(
            30,
            100,
            160,
            .04
        );

    transition:

        border-color .15s,
        background .15s,
        box-shadow .15s;

}


.primary-button:hover {

    border-color:
        var(--blue);

    background:
        #0b1a29;

}


.primary-button:active {

    background:
        #102237;

    transform:
        translateY(1px);

}


/* =========================================================
   RESEARCHER PANEL
========================================================= */

.researcher-panel {

    width:
        760px;

    max-width:
        82%;

    padding:
        58px;

    border:
        1px solid
        var(--line);

    background:
        rgba(
            16,
            22,
            25,
            .94
        );

    box-shadow:

        0 0 40px
        rgba(
            0,
            0,
            0,
            .28
        );

}


.researcher-panel h2 {

    margin:
        10px 0 0;

    color:
        #d7e4ec;

    font-family:
        var(--font-korean-pixel);

    font-size:
        48px;

    font-weight:
        400;

    line-height:
        1.6;

}


.researcher-panel p {

    margin:
        16px 0 0;

    color:
        var(--muted);

    font-family:
        var(--font-korean-pixel);

    font-size:
        25px;

    line-height:
        1.8;

}


.researcher-panel input {

    width:
        100%;

    margin-top:
        30px;

    padding:
        19px;

    border:
        1px solid
        var(--line);

    background:
        #0a0f11;

    color:
        var(--text);

    font-family:
        var(--font-digital);

    font-size:
        36px;

    letter-spacing:
        .12em;

    caret-color:
        var(--blue-bright);

}


.researcher-panel input::placeholder {

    color:
        #405462;

    opacity:
        1;

    font-family:
        var(--font-digital);

    font-size:
        29px;

}


.researcher-panel button {

    margin-top:
        26px;

    min-width:
        180px;

    min-height:
        64px;

    padding:
        15px 30px;

    border:
        1px solid
        #28547a;

    background:
        #081522;

    color:
        #c7d8e3;

    font-family:
        var(--font-digital);

    font-size:
        30px;

    letter-spacing:
        .12em;

}

/* =========================================================
   NULVA
   app.css
   PART 2 / 5
   LAB SCREEN + TOP BAR + MAIN GRID
========================================================= */


/* =========================================================
   LAB SCREEN
========================================================= */

.lab-screen {

    display:
        flex;

    flex-direction:
        column;

    background:
        var(--bg);

}


/* =========================================================
   TOP BAR
========================================================= */

.topbar {

    height:
        88px;

    min-height:
        88px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    padding:
        0 30px;

    gap:
        20px;

    border-bottom:
        1px solid
        var(--line);

    background:
        #04080d;

}


/* =========================================================
   BRAND
========================================================= */

.brand {

    min-width:
        0;

    display:
        flex;

    align-items:
        baseline;

    gap:
        16px;

    color:
        var(--muted);

    font-family:
        var(--font-digital);

    font-size:
        21px;

    letter-spacing:
        .08em;

}


.brand strong {

    flex-shrink:
        0;

    color:
        #e1edf5;

    font-family:
        var(--font-logo);

    font-size:
        34px;

    font-weight:
        600;

    letter-spacing:
        .24em;

    line-height:
        1;

    transform:
        translateX(
            .12em
        );

}


.brand span {

    min-width:
        0;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

    white-space:
        nowrap;

    color:
        #60788a;

    font-family:
        var(--font-korean-pixel);

    font-size:
        20px;

}


/* =========================================================
   TOP STATUS
========================================================= */

.top-status {

    min-width:
        0;

    display:
        flex;

    align-items:
        center;

    justify-content:
        flex-end;

    gap:
        30px;

    color:
        var(--muted);

    font-family:
        var(--font-digital);

    font-size:
        24px;

    white-space:
        nowrap;

}


.top-status span {

    display:
        flex;

    align-items:
        center;

    gap:
        7px;

}


.top-status b {

    color:
        var(--text);

    font-family:
        var(--font-digital);

    font-size:
        29px;

    font-weight:
        400;

}


/* =========================================================
   FACILITY STATUS LIGHT
========================================================= */

.facility-status i {

    display:
        inline-block;

    width:
        9px;

    height:
        9px;

    margin-right:
        7px;

    border-radius:
        50%;

    background:
        var(--blue);

    box-shadow:

        0 0 8px
        rgba(
            76,
            159,
            255,
            .65
        );

}


/* =========================================================
   MAIN GRID
========================================================= */

.main-grid {

    flex:
        1 1 auto;

    min-width:
        0;

    min-height:
        0;

    display:
        grid;

    grid-template-columns:
        18%
        60%
        22%;

    gap:
        1px;

    overflow:
        hidden;

    background:
        var(--line);

}


/* =========================================================
   GENERIC PANEL
========================================================= */

.panel {

    min-width:
        0;

    min-height:
        0;

    overflow:
        hidden;

    background:

        linear-gradient(
            135deg,
            #0a1017,
            #070c11
        );

}


/* =========================================================
   SUBJECT PANEL
========================================================= */

.subject-panel {

    min-width:
        0;

    min-height:
        0;

    padding:
        28px;

    overflow:
        auto;

    scrollbar-width:
        thin;

    scrollbar-color:
        #1b3447
        transparent;

}


/* =========================================================
   STATUS PANEL
========================================================= */

.status-panel {

    min-width:
        0;

    min-height:
        0;

    padding:
        28px;

    overflow:
        auto;

    scrollbar-width:
        thin;

    scrollbar-color:
        #1b3447
        transparent;

}


/* =========================================================
   PANEL SCROLLBAR
========================================================= */

.subject-panel::-webkit-scrollbar,
.status-panel::-webkit-scrollbar {

    width:
        5px;

}


.subject-panel::-webkit-scrollbar-track,
.status-panel::-webkit-scrollbar-track {

    background:
        transparent;

}


.subject-panel::-webkit-scrollbar-thumb,
.status-panel::-webkit-scrollbar-thumb {

    background:
        #1b3447;

}


/* =========================================================
   PANEL TITLE
========================================================= */

.panel-title {

    margin:
        0 0 22px;

    color:
        #718899;

    font-family:
        var(--font-digital);

    font-size:
        26px;

    letter-spacing:
        .16em;

}


/* =========================================================
   SUBJECT CARD
========================================================= */

.subject-card {

    width:
        100%;

    min-height:
        112px;

    box-sizing:
        border-box;

    margin:
        0 0 12px;

    padding:
        21px 19px;

    border:
        1px solid
        transparent;

    background:
        #0d1315;

    color:
        var(--text);

    text-align:
        left;

    touch-action:
        manipulation;

    -webkit-tap-highlight-color:
        transparent;

    transition:

        border-color .15s,
        background .15s,
        box-shadow .15s,
        transform .08s;

}


/* =========================================================
   SUBJECT CARD ACTIVE
========================================================= */

.subject-card.active {

    border-color:
        #28547a;

    background:
        #0b1722;

    box-shadow:

        inset 4px 0 0
        var(--blue);

}


/* =========================================================
   SUBJECT CARD HOVER
========================================================= */

.subject-card:hover {

    border-color:
        #1c3b53;

    background:
        #0e1821;

}


/* =========================================================
   SUBJECT CARD ID
========================================================= */

.subject-card .id {

    color:
        var(--muted);

    font-family:
        var(--font-digital);

    font-size:
        25px;

    letter-spacing:
        .06em;

}


/* =========================================================
   SUBJECT CARD NAME
========================================================= */

.subject-card h3 {

    margin:
        8px 0 10px;

    color:
        #dce9f1;

    font-family:
        var(--font-korean-pixel);

    font-size:
        34px;

    font-weight:
        500;

    letter-spacing:
        .04em;

    line-height:
        1.05;

}


/* =========================================================
   SUBJECT CARD STATUS
========================================================= */

.subject-card p {

    margin:
        0;

    color:
        var(--muted);

    font-family:
        var(--font-korean-pixel);

    font-size:
        22px;

    line-height:
        1.6;

}


/* =========================================================
   STATUS DOT
========================================================= */

.dot {

    display:
        inline-block;

    width:
        8px;

    height:
        8px;

    margin-right:
        7px;

    border-radius:
        50%;

    background:
        var(--ok);

    box-shadow:

        0 0 7px
        rgba(
            111,
            168,
            142,
            .35
        );

}


/* =========================================================
   LAB VIEW
========================================================= */

.lab-view {

    position:
        relative;

    min-width:
        0;

    min-height:
        0;

    display:
        flex;

    flex-direction:
        column;

    align-items:
        center;

    justify-content:
        center;

    overflow:
        hidden;

    background:

        linear-gradient(
            #11191b,
            #0b1012
        );

}


/* =========================================================
   LAB VIEW VIGNETTE
========================================================= */

.lab-view::before {

    content:
        "";

    position:
        absolute;

    inset:
        0;

    z-index:
        9;

    pointer-events:
        none;

    background:

        radial-gradient(
            ellipse at center,
            transparent 45%,
            rgba(
                0,
                0,
                0,
                .28
            ) 100%
        );

}


/* =========================================================
   LAB VIEW SCANLINE
========================================================= */

.lab-view::after {

    content:
        "";

    position:
        absolute;

    inset:
        0;

    z-index:
        10;

    pointer-events:
        none;

    background:

        repeating-linear-gradient(
            0deg,
            transparent 0,
            transparent 3px,
            rgba(
                114,
                201,
                255,
                .018
            ) 4px
        );

    opacity:
        .5;

}


/* =========================================================
   CAMERA LABEL
========================================================= */

.camera-label {

    position:
        absolute;

    top:
        22px;

    left:
        26px;

    z-index:
        5;

    color:
        var(--muted);

    font-family:
        var(--font-digital);

    font-size:
        24px;

    letter-spacing:
        .08em;

}


.camera-label span {

    margin-left:
        10px;

    color:
        var(--blue-bright);

    text-shadow:

        0 0 8px
        rgba(
            114,
            201,
            255,
            .35
        );

}


.camera-label small {

    margin-left:
        10px;

    color:
        #46657a;

    font-family:
        var(--font-digital);

    font-size:
        20px;

}


/* =========================================================
   CAMERA WARNING
========================================================= */

.camera-warning {

    position:
        absolute;

    top:
        68px;

    left:
        50%;

    z-index:
        20;

    transform:
        translateX(-50%);

    padding:
        9px 18px;

    border:
        1px solid
        rgba(
            196,
            154,
            85,
            .45
        );

    background:
        rgba(
            18,
            15,
            10,
            .82
        );

    color:
        var(--warning);

    font-family:
        var(--font-digital);

    font-size:
        22px;

    letter-spacing:
        .10em;

    box-shadow:

        0 0 14px
        rgba(
            196,
            154,
            85,
            .08
        );

}

/* =========================================================
   NULVA
   app.css
   PART 3 / 5
   CHAMBER + MIRA + SUBJECT STATUS
========================================================= */


/* =========================================================
   CHAMBER
========================================================= */

.chamber {

    position:
        relative;

    width:
        78%;

    height:
        72%;

    min-width:
        420px;

    min-height:
        300px;

    max-width:
        860px;

    max-height:
        520px;

    overflow:
        hidden;

    border:
        1px solid
        #29495e;

    background:

        linear-gradient(
            180deg,
            #1a272b 0%,
            #10191d 42%,
            #080d10 100%
        );

    box-shadow:

        0 0 0 1px
        rgba(
            255,
            255,
            255,
            .02
        ),

        inset 0 0 50px
        rgba(
            0,
            0,
            0,
            .55
        ),

        0 0 35px
        rgba(
            76,
            159,
            255,
            .04
        );

}


/* =========================================================
   CHAMBER GLASS
========================================================= */

.chamber::before {

    content:
        "";

    position:
        absolute;

    inset:
        0;

    z-index:
        4;

    pointer-events:
        none;

    background:

        linear-gradient(
            90deg,
            rgba(
                255,
                255,
                255,
                .035
            ),
            transparent 14%,
            transparent 84%,
            rgba(
                255,
                255,
                255,
                .018
            )
        );

}


/* =========================================================
   CEILING LIGHT
========================================================= */

.ceiling-light {

    position:
        absolute;

    top:
        14px;

