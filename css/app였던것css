            1;

        filter:
            blur(
                0
            );

    }

}

/* =========================================================
   TOAST
   최종 수정본
   - 화면 중앙 하단
   - 모달보다 훨씬 작게
   - 짧은 시스템 메시지처럼 표시
   - 기존 .toast 이름 유지
========================================================= */


/* =========================================================
   TOAST BASE
========================================================= */

.toast {

    position:
        absolute;

    left:
        50%;

    bottom:
        148px;

    z-index:
        1000;

    width:
        max-content;

    max-width:
        520px;

    min-width:
        0;

    box-sizing:
        border-box;

    padding:
        11px 20px;

    transform:
        translateX(-50%)
        translateY(8px);

    border:
        1px solid
        #294b63;

    background:
        rgba(
            5,
            12,
            18,
            .94
        );

    color:
        #aebfca;

    font-family:
        var(--font-korean-pixel);

    font-size:
        12px;

    font-weight:
        400;

    line-height:
        1.6;

    letter-spacing:
        0;

    text-align:
        center;

    white-space:
        normal;

    word-break:
        keep-all;

    overflow-wrap:
        anywhere;

    box-shadow:

        0 0 18px
        rgba(
            0,
            0,
            0,
            .28
        ),

        0 0 12px
        rgba(
            76,
            159,
            255,
            .05
        );

    opacity:
        0;

    visibility:
        hidden;

    pointer-events:
        none;

    transition:

        opacity .18s ease,

        transform .18s ease,

        visibility .18s ease;

}


/* =========================================================
   TOAST SHOW
========================================================= */

.toast.show {

    opacity:
        1;

    visibility:
        visible;

    transform:
        translateX(-50%)
        translateY(0);

}


/* =========================================================
   TOAST SYSTEM
========================================================= */

.toast.system {

    border-color:
        #294b63;

    color:
        #aebfca;

}


/* =========================================================
   TOAST SUCCESS
========================================================= */

.toast.success {

    border-color:
        rgba(
            69,
            232,
            137,
            .35
        );

    color:
        #a9d9ba;

    box-shadow:

        0 0 18px
        rgba(
            69,
            232,
            137,
            .06
        );

}


/* =========================================================
   TOAST WARNING
========================================================= */

.toast.warning {

    border-color:
        rgba(
            196,
            154,
            85,
            .42
        );

    color:
        #cbb58b;

}


/* =========================================================
   TOAST DANGER
========================================================= */

.toast.danger {

    border-color:
        rgba(
            168,
            94,
            107,
            .42
        );

    color:
        #c99ba4;

}


/* =========================================================
   TOAST ANOMALY
========================================================= */

.toast.anomaly {

    border-color:
        rgba(
            114,
            201,
            255,
            .45
        );

    color:
        #b9d9e9;

    box-shadow:

        0 0 20px
        rgba(
            76,
            159,
            255,
            .10
        );

}


/* =========================================================
   TOAST TEXT
========================================================= */

.toast b {

    color:
        #d5e5ee;

    font-family:
        var(--font-korean-pixel);

    font-size:
        12px;

    font-weight:
        400;

}


/* =========================================================
   TOAST DIGITAL TEXT
========================================================= */

.toast .system-code {

    margin-right:
        8px;

    color:
        #52758b;

    font-family:
        var(--font-digital);

    font-size:
        13px;

    letter-spacing:
        .06em;

}


/* =========================================================
   TOAST FADE
========================================================= */

@keyframes nulva-toast-in {

    from {

        opacity:
            0;

        transform:
            translateX(-50%)
            translateY(8px);

    }

    to {

        opacity:
            1;

        transform:
            translateX(-50%)
            translateY(0);

    }

}


/* =========================================================
   TOAST MOBILE / SMALL VIEWPORT
========================================================= */

@media (
    max-width: 900px
) {

    .toast {

        bottom:
            132px;

        max-width:
            70%;

        padding:
            10px 16px;

        font-size:
            11px;

    }

}


